# ─── Supabase (requis) ──────────────────────────────────────────────────────
# NEXT_PUBLIC_* est exposé au navigateur par construction. La sécurité des
# données repose donc entièrement sur les policies RLS : ne jamais créer de
# policy `USING (true)` sans clause `TO`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Contourne RLS — strictement serveur, jamais importé par un composant client.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Anthropic (requis) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Surcharges de modèle (facultatif). Par défaut : Sonnet 4 pour l'analyse,
# Haiku 4.5 pour le rerank, la clarification et le chat.
# ANALYZE_MODEL=
# CHAT_MODEL=

# ─── PISTE — Judilibre & Légifrance (facultatif) ────────────────────────────
# Sans ces clés, l'application fonctionne mais aucun corpus n'est récupéré :
# l'analyse indique alors qu'elle n'est pas réalisable.
PISTE_KEY_ID=
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=
# "true" pour l'environnement de bac à sable PISTE.
# PISTE_SANDBOX=

# ─── Voyage AI (facultatif) ─────────────────────────────────────────────────
# Active le rerank sémantique du corpus. Sans cette clé, seul le scoring
# Haiku est utilisé.
VOYAGE_API_KEY=

# ─── Emails transactionnels (facultatif) ────────────────────────────────────
# Sans RESEND_API_KEY, l'envoi est un no-op silencieux (pratique en local).
RESEND_API_KEY=
EMAIL_FROM=
# Destinataire des notifications d'inscription.
ADMIN_EMAIL=

# ─── Contrôle d'accès (requis en production) ────────────────────────────────
# Liste d'emails administrateurs, séparés par des virgules. Ces comptes
# accèdent à /admin et sont approuvés d'office.
ADMIN_EMAILS=

# ─── Cron (requis si le cron est activé) ────────────────────────────────────
# Sans cette variable, /api/cron/check-cph refuse toute requête.
CRON_SECRET=

# ─── Application ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Taux de conversion affiché dans le suivi des coûts (défaut : 0.92).
# USD_EUR_RATE=

# ─── Mentions légales (requis en production — LCEN art. 6-III) ──────────────
# Renseignés, ces champs alimentent les pages légales. Absents, les rubriques
# correspondantes ne s'affichent pas.
NEXT_PUBLIC_LEGAL_COMPANY=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_RCS=
NEXT_PUBLIC_LEGAL_CAPITAL=
NEXT_PUBLIC_LEGAL_VAT=
NEXT_PUBLIC_LEGAL_PUBLISHER=
NEXT_PUBLIC_LEGAL_DPO_EMAIL=
